# Personal access token used by the GitHub stats route (app/api/github/route.ts).
# Needs no scopes for public data; classic token with `public_repo` is plenty.
# Create one at https://github.com/settings/tokens
GITHUB_PAT=

# Resend API key for the contact form (app/api/contact/route.ts).
# Without it the form reports that delivery is unconfigured and offers a
# mailto fallback -- it never claims a message was sent.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides. Defaults are the portfolio owner's address and Resend's
# shared sender, which works before you verify a domain of your own.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
